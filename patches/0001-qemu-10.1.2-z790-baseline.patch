+static const uint32_t capture_rates[] = {44100,48000,96000,192000};
+static const uint32_t spdif_rates[] = {44100,48000,88200,96000,192000};
+static const uint32_t *stream_rates(int si,unsigned *nr)
+{
+    if(si<3){*nr=ARRAY_SIZE(capture_rates);return capture_rates;}
+    if(si==5){*nr=ARRAY_SIZE(spdif_rates);return spdif_rates;}
+    *nr=si==4?7:6;return rates;
