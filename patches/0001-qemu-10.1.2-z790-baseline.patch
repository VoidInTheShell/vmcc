+    USBDeviceClass *k=USB_DEVICE_CLASS(oc);k->usb_desc=&hs_desc;k->product_desc="USB2.0 Hub";
+    k->handle_attach=usb_desc_attach;k->handle_control=hs_hub_control;
+}
