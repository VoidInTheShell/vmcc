+static void volume(ALCStream *st)
+{
+    Volume v = {.channels=st->channels,.mute=st->mute};
+    for (int c=0;c<v.channels;c++) {
+        double amp = pow(10.0, (st->db[0]+st->db[c+1])/5120.0);
+        v.vol[c] = MIN(255, (int)(amp*255));
+    }
+    if(st->out) audio_set_volume_out(st->out,&v);
+    if(st->in) audio_set_volume_in(st->in,&v);
+}
+static void audio_callback(void *opaque,int avail)
+{
+    ALCStream *st=opaque;
+    unsigned frame=st->channels*(st->bytes==2?2:4);
+    if (!st->alt || !frame) return;
+    while (avail>0) {
+        size_t pos=(st->capture?st->put:st->get)%RING_SIZE;
+        size_t count=st->capture?RING_SIZE-(st->put-st->get):st->put-st->get;
+        count=MIN(count,MIN(avail,RING_SIZE-pos));
+        count-=count%frame;
