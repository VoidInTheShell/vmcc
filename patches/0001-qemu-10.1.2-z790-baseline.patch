+    size_t size;
+    uint32_t regs[1024];
+};
+static uint64_t read_reg(void *opaque,hwaddr addr,unsigned size)
+{
+    Z790SPIState *s=opaque;
+    uint32_t val=s->regs[addr>>2];
+    return (val>>((addr&3)*8)) & (size==4?0xffffffffu:((1u<<(size*8))-1));
