+    }else if(index==2 || (index>=4&&index<20))s->regs[index]=merged;
+    /* Descriptor, access and protection registers remain locked. */
+}
+static const MemoryRegionOps ops={.read=read_reg,.write=write_reg,
+    .endianness=DEVICE_LITTLE_ENDIAN,.valid={.min_access_size=1,.max_access_size=4}};
+static void realize(PCIDevice *dev,Error **errp)
+{
+    Z790SPIState *s=Z790_SPI(dev);gchar *bytes=NULL;gsize length=0;GError *error=NULL;
