+static bool igb_is_i226(IGBCore *core)
+{
+    return (pci_get_word(core->owner->config + PCI_DEVICE_ID) == 0x125c || pci_get_word(core->owner->config + PCI_DEVICE_ID) == 0x15f3);
+}
+
+static hwaddr i226_register_address(hwaddr addr)
+{
+    /* I226 interrupts are at 0x1500, unlike 82576 legacy registers. */
+    switch (addr) {
+    case 0x1500: return E1000_ICR;
+    case 0x1504: return E1000_ICS;
+    case 0x1508: return E1000_IMS;
+    case 0x150c: return E1000_IMC;
+    case 0x1510: return E1000_IAM;
+    case 0x12014: return E1000_EERD;
+    }
+    return addr;
+}
+
+static void igb_set_phy_ctrl(IGBCore *core, uint16_t val);
+static void i226_set_mdic(IGBCore *core, uint32_t value)
+{
+    unsigned reg = (value >> 16) & 31;
+    unsigned mmd = core->gpy_control & 31;
+    unsigned adr = core->gpy_address;
+    uint16_t data = value;
+    if (value & E1000_MDIC_OP_READ) {
+        if (reg == 13) {
+            data = core->gpy_control;
+        } else if (reg == 14 && (core->gpy_control & 0x4000)) {
+            data = adr < 256 ? core->gpy_mmd[mmd][adr] : 0;
+        } else if (reg == 14) {
+            data = core->gpy_address;
+        } else {
+            data = core->phy[reg];
+        }
+        value = (value & ~0xffffu) | data;
+    } else if (value & E1000_MDIC_OP_WRITE) {
+        if (reg == 13) {
+            core->gpy_control = data;
+        } else if (reg == 14 && (core->gpy_control & 0x4000)) {
+            if (adr < 256) {
+                core->gpy_mmd[mmd][adr] = data;
+            }
+        } else if (reg == 14) {
+            core->gpy_address = data;
+        } else if (reg == MII_BMCR) {
+            igb_set_phy_ctrl(core, data);
+        } else if (reg != MII_BMSR && reg != MII_PHYID1 && reg != MII_PHYID2) {
+            core->phy[reg] = data;
+        }
+    }
+    core->mac[MDIC] = (value & ~E1000_MDIC_ERROR) | E1000_MDIC_READY;
+}
