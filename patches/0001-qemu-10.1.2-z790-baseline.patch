+/* HECI transport and a bounded MKHI service model, SPDX-License-Identifier: GPL-2.0-or-later.
+ * This executes a protocol model, not proprietary CSME firmware. PTT, AMT,
+ * Boot Guard attestation, provisioning, updates and cryptographic services
+ * are deliberately not advertised. The version comes from the BIOS manifest.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/bswap.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_device.h"
+#include "hw/pci/msi.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+#define TYPE_Z790_ME "z790-me"
+OBJECT_DECLARE_SIMPLE_TYPE(Z790MEState,Z790_ME)
+struct Z790MEState {
+    PCIDevice parent_obj;
+    MemoryRegion mmio;
+    QEMUTimer *reset_timer;
+    char *image;
+    uint32_t hcsr,host[256],me[256];
+    uint8_t hwp,hrp,mwp,mrp;
+    uint8_t pending[256][512];
+    uint16_t pending_len[256],version[4];
+    uint8_t host_id;
+    bool connected,ready;
+};
+static const uint8_t mkhi_uuid[16]={0x84,0x35,0x21,0x55,0x29,0x9a,0x16,0x49,0xba,0xdf,0x0f,0xb7,0xed,0x68,0x2a,0xeb};
+static void irq_update(Z790MEState *s)
+{
+    PCIDevice *d=PCI_DEVICE(s);
+    bool level=(s->hcsr&3)==3;
+    if(msi_enabled(d)){
+        pci_set_irq(d,0);
+        if(level)msi_notify(d,0);
+    }else pci_set_irq(d,level);
+}
+static void signal_irq(Z790MEState *s){s->hcsr|=2;irq_update(s);}
+static void reply(Z790MEState *s,uint8_t me,uint8_t host,const uint8_t *data,size_t n)
+{
+    unsigned words=(n+3)/4;
