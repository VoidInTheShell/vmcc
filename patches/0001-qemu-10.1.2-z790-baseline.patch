+    memset(data,0,64);
+    switch(op){
+    case 0: /* READ */
+        if(address>s->size || count>s->size-address)error=true;
+        else memcpy(data,s->flash+address,count);
+        break;
+    case 5: /* SFDP: unsupported table triggers known-JEDEC-ID fallback. */
+        memset(data,0xff,count);break;
+    case 6: /* A functional 32MiB W25Q256-compatible flash backend. */
+        data[0]=0xef;data[1]=0x40;data[2]=0x19;break;
+    case 8: /* RDSR; all blocks protected, no operation in progress. */
+        data[0]=0x1c;break;
+    default: /* Writes, status updates and erases are hardware-protected. */
+        error=true;break;
+    }
+    s->regs[1]=(ctl&0xff1ec000)|0xc000|(error?2:1);
