+static const uint8_t endpoints[6] = {0x81,0x83,0x84,5,6,8};
+static const USBDescStrings strings = {
+    [1]="USB Audio", [3]="Generic", [4]="USB Audio",
+    [5]="Realtek USB2.0 Audio", [10]="Analog In", [11]="Line",
+    [12]="Mic", [13]="Speaker", [14]="Front Headphone", [15]="IEC958",
+};
